# Redis REST proxy — for local dev, docker compose -f ../../docker-compose.dev.yml up -d
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=dev_token

# Shared secret the ESP32 presents on the websocket upgrade
DEVICE_TOKEN=change-me

# bcrypt hash of the admin password + secret for signing the session cookie
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
