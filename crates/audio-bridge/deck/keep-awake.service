[Unit]
Description=Keep the Deck awake for the traffic light
Documentation=file:%h/audio-bridge/deck/README.md

[Service]
# The daemon holds an inhibitor of its own while it runs. This covers the gap
# around it — soundcheck, a stopped daemon, the walk between sets — because an
# idle Deck suspends in eight minutes and comes back with the light dark.
#
# An inhibitor rather than a power-management setting because it is the mechanism
# already known to hold on this box, it needs no root, and stopping this unit is
# the whole of undoing it.
ExecStart=/usr/bin/systemd-inhibit \
    --what=idle:sleep \
    --who=traffic-light \
    --why="keeping the light alive" \
    /usr/bin/sleep infinity
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
