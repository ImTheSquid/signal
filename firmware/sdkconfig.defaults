# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack variables in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# NB: no partition table is set here, and none of the stock ones would fit.
# Rhai plus the wifi/TLS stack builds to ~2.3MB, while single-app is 1M and
# single-app-large is 1500K. This works because espflash ignores the IDF table
# and writes its own 0x3F0000 (3.9MB) app layout — the app sits at ~57% of that.
# Consequence: flash with espflash (`cargo run`). A plain `idf.py` build, or
# passing --partition-table explicitly, will fail with "app partition too small".

# wss:// cert validation against the built-in CA bundle
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# TLS memory diet — the board runs close to the heap floor and a reconnect
# handshake must always be able to allocate.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# The inbound record buffer, left at the 16K default while everything around it
# was trimmed. Halved rather than cut to 4K because a record larger than this
# fails the connection outright, and the handshake's certificate chain is the
# biggest thing the light ever receives — the JSON frames are tiny.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192

# Trim wifi buffers (defaults are sized for throughput we don't need)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# Block-ack reorder window. Six is for sustained throughput; this device sends
# state every 20s and receives a script now and then.
CONFIG_ESP_WIFI_RX_BA_WIN=2

# lwip windows, also sized for throughput this device has no use for. One
# websocket and one UDP socket, not a file transfer.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_MAX_SOCKETS=6

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096
