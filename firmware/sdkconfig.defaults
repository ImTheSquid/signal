# Rust needs more main-task stack than C's 3K default. 16K came from the project
# template; the main task brings up wifi, SNTP and the websocket and then runs the
# event loop, none of which is deep. Scripts run on their own thread with their
# own stack, so this is not what has to grow for them.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# NB: no partition table is set here, and none of the stock ones would fit.
# Rhai plus the wifi/TLS stack builds to ~2.3MB, while single-app is 1M and
# single-app-large is 1500K. This works because espflash ignores the IDF table
# and writes its own 0x3F0000 (3.9MB) app layout — the app sits at ~57% of that.
# Consequence: flash with espflash (`cargo run`). A plain `idf.py` build, or
# passing --partition-table explicitly, will fail with "app partition too small".

# wss:// cert validation against the built-in CA bundle
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# TLS memory diet — the board runs close to the heap floor and a reconnect
# handshake must always be able to allocate.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# Trim wifi buffers (defaults are sized for throughput we don't need)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# Task stacks come out of the same heap the interpreter needs, and there are
# several of them. Raised above their defaults by the project template rather
# than by measurement; trimmed back towards it.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
# Two of these, one per core.
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2048

# Nothing here speaks IPv6, and the stack costs several KB of buffers and PCBs.
CONFIG_LWIP_IPV6=n

# Block-ack reordering buffers exist for sustained throughput. This device sends
# a state frame every 20s and receives a script now and then.
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# You might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096
